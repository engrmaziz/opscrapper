# Google Antigravity & AI Model Configuration
ANTIGRAVITY_API_KEY=your_antigravity_api_key_here
ANTIGRAVITY_ENV=development
LOG_LEVEL=INFO
GEMINI_API_KEY=your_gemini_api_key_here

# Job Search Defaults
DEFAULT_JOB_KEYWORD=AI Engineer
DEFAULT_LOCATION=Remote
MAX_JOB_BOARDS=14

# Output Directories
DATA_RAW_DIR=data/raw
DATA_EXPORTS_DIR=data/exports
LOGS_DIR=logs

# Network & Web UI Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8060
AUTH_KEY=your_secret_access_key
